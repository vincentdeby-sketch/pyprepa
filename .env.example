# Copie ce fichier en .env et remplis les valeurs.

# Port d'ecoute
PORT=3000

# Secret de signature des jetons de session. Mets une longue chaine aleatoire.
JWT_SECRET=change-moi-par-une-longue-chaine-aleatoire

# Compte administrateur cree au premier demarrage
ADMIN_EMAIL=admin@exemple.fr
ADMIN_PASSWORD=change-moi

# Cle API Anthropic partagee (facultatif ici : tu peux aussi la saisir
# depuis le panneau d'administration une fois connecte).
ANTHROPIC_API_KEY=

# Chemin du fichier de base de donnees
DB_PATH=./data/pyprepa.db
